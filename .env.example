# Copy to .env.local and fill in. .env.local is gitignored.
# On Netlify, add the "Dashboard" variables under Site configuration > Environment variables.
# Tokens are only read on the server and are never logged.

# ---- Dashboard (server: .env.local for local dev, and Netlify env vars) ----

# Supabase Postgres for manual entries + Claude data. Supabase dashboard > Connect >
# "Transaction pooler" connection string (port 6543), with your database password filled in.
DATABASE_URL=

# Login via Supabase (see README: Inloggen). All four are needed.
# Your Supabase project URL, e.g. https://abcdefghij.supabase.co
SUPABASE_URL=
# Supabase > Project Settings > API Keys: the publishable (anon) key. Public, not a secret.
SUPABASE_PUBLISHABLE_KEY=
# Who may log in (comma-separated). Other users of the same Supabase project are refused.
DASHBOARD_ALLOWED_EMAILS=
# Long random string that signs the 30-day login cookie. Changing it logs every device out.
SESSION_SECRET=

# Optional fallback: HTTP Basic auth password (any username), e.g. for curl. Leave empty to switch it off.
DASHBOARD_PASSWORD=

# Long random string shared with the sync script on your computers.
# Generate one with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
INGEST_SECRET=

# Read-only key for the home-screen widget (GET /api/widget, header "Authorization: Bearer ...").
# Separate from the password and INGEST_SECRET, so you can rotate it on its own.
# Generate a strong one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WIDGET_TOKEN=

# Timezone for "today" and displayed times. Netlify runs in UTC.
DASHBOARD_TIMEZONE=Europe/Amsterdam

# Netlify personal access token: User settings > Applications > Personal access tokens
NETLIFY_TOKEN=
# Optional: team slug, if you belong to more than one Netlify team (default: your default team)
# NETLIFY_ACCOUNT=

# Supabase personal access token (scoped, read-only): Account preferences > Access Tokens (sbp_...)
SUPABASE_TOKEN=
# Optional: only these projects (comma-separated refs or names). Default: all projects.
# SUPABASE_PROJECTS=

# n8n (planned, not used yet)
# N8N_API_KEY=
# N8N_BASE_URL=http://localhost:5678

# ---- Sync script (each computer where you use Claude Code: .env.local only) ----

# Where the dashboard runs, e.g. https://your-site.netlify.app (or http://localhost:3000)
DASHBOARD_URL=
# INGEST_SECRET above must match the dashboard's.
# Optional: name for this computer on the dashboard (default: hostname)
# MACHINE_NAME=
# Optional: override where Claude Code logs live (default ~/.claude)
# CLAUDE_CONFIG_DIR=
